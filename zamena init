case MemoryMode.INIT:
    Random random = new Random();
    
    for (int i = 0; i < numofneurons; i++)
    {
        // Генерируем веса с нормальным распределением
        for (int j = 0; j < numofprevneurons + 1; j++)
        {
            double u1 = 1.0 - random.NextDouble();
            double u2 = 1.0 - random.NextDouble();
            weights[i, j] = Math.Sqrt(-2.0 * Math.Log(u1)) * Math.Sin(2.0 * Math.PI * u2);
        }
        
        // Гарантируем точное N(0,1) для каждого нейрона
        double mean = 0;
        double stdDev = 0;
        
        // Вычисляем текущие статистики
        for (int j = 0; j < numofprevneurons + 1; j++)
        {
            mean += weights[i, j];
        }
        mean /= (numofprevneurons + 1);
        
        for (int j = 0; j < numofprevneurons + 1; j++)
        {
            stdDev += (weights[i, j] - mean) * (weights[i, j] - mean);
        }
        stdDev = Math.Sqrt(stdDev / (numofprevneurons + 1));
        
        // Стандартизируем к точному N(0,1)
        for (int j = 0; j < numofprevneurons + 1; j++)
        {
            weights[i, j] = (weights[i, j] - mean) / stdDev;
        }
    }


case MemoryMode.INIT:
    Random random = new Random();
    
    for (int i = 0; i < numofneurons; i++)
    {
        for (int j = 0; j < numofprevneurons + 1; j++)
        {
            // Метод Бокс-Мюллер для нормального распределения N(0,1)
            double u1 = 1.0 - random.NextDouble(); // (0,1]
            double u2 = 1.0 - random.NextDouble();
            
            double radius = Math.Sqrt(-2.0 * Math.Log(u1));
            double theta = 2.0 * Math.PI * u2;
            
            weights[i, j] = radius * Math.Sin(theta); // или Math.Cos(theta)
        }
    }
    
    // Сохранение...
    break;



case MemoryMode.INIT:
    Random random = new Random();
    
    // Инициализация весов стандартным нормальным распределением N(0,1)
    for (int i = 0; i < numofneurons; i++)
    {
        for (int j = 0; j < numofprevneurons + 1; j++)
        {
            // Бокс-Мюллер преобразование для нормального распределения N(0,1)
            double u1 = 1.0 - random.NextDouble(); // (0,1] -> избегаем 0
            double u2 = 1.0 - random.NextDouble();
            double randStdNormal = Math.Sqrt(-2.0 * Math.Log(u1)) * 
                                 Math.Sin(2.0 * Math.PI * u2);
            
            weights[i, j] = randStdNormal;
        }
    }
    
    // Проверка и коррекция статистик для каждого нейрона
    for (int i = 0; i < numofneurons; i++)
    {
        // Вычисляем статистики для весов текущего нейрона
        double sum = 0;
        double sumSquares = 0;
        int weightCount = numofprevneurons + 1;
        
        for (int j = 0; j < weightCount; j++)
        {
            sum += weights[i, j];
            sumSquares += weights[i, j] * weights[i, j];
        }
        
        double mean = sum / weightCount;
        double variance = (sumSquares / weightCount) - (mean * mean);
        double stdDev = Math.Sqrt(Math.Max(variance, 0.0001)); // защита от отрицательной дисперсии
        
        // Стандартизация: преобразуем к N(0,1)
        for (int j = 0; j < weightCount; j++)
        {
            weights[i, j] = (weights[i, j] - mean) / stdDev;
        }
        
        // Дополнительная проверка после стандартизации
        sum = 0;
        sumSquares = 0;
        for (int j = 0; j < weightCount; j++)
        {
            sum += weights[i, j];
            sumSquares += weights[i, j] * weights[i, j];
        }
        
        double finalMean = sum / weightCount;
        double finalStdDev = Math.Sqrt(sumSquares / weightCount - finalMean * finalMean);
        
        // Для отладки можно вывести статистики
        // Console.WriteLine($"Нейрон {i}: Mean={finalMean:F6}, StdDev={finalStdDev:F6}");
    }

    // Сохранение в CSV
    string[] lines = new string[numofneurons];
    for (int i = 0; i < numofneurons; i++)
    {
        string[] row = new string[numofprevneurons + 1];
        for (int j = 0; j < numofprevneurons + 1; j++)
        {
            row[j] = weights[i, j]
                .ToString(System.Globalization.CultureInfo.InvariantCulture)
                .Replace('.', ',');
        }
        lines[i] = string.Join(";", row);
    }
    File.WriteAllLines(path, lines);
    break;
